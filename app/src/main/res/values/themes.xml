<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Light Theme -->
    <style name="Theme.SonosSequencer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/sonos_white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/sonos_white</item>
        
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/sonos_black</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">@color/divider_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/sonos_white</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        
        <!-- App bar -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        
        <!-- Floating action button -->
        <item name="colorPrimarySurface">@color/primary</item>
        
        <!-- Switch -->
        <item name="colorSwitchThumbNormal">@color/primary</item>
        
        <!-- Radio button -->
        <item name="colorControlActivated">@color/primary</item>
        
        <!-- Checkbox -->
        <item name="colorControlNormal">@color/primary</item>
        
        <!-- Text input -->
        <item name="colorControlNormal">@color/input_border</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/primary_light</item>
        
        <!-- Bottom navigation -->
        <item name="bottomNavigationStyle">@style/Widget.SonosSequencer.BottomNavigationView</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.SonosSequencer.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/divider_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="input_background">@color/surface_dark</item>
        <item name="input_text">@color/text_primary_dark</item>
        <item name="input_hint">@color/text_secondary_dark</item>
        <item name="input_border">@color/divider_dark</item>
    </style>

    <!-- Custom styles -->
    <style name="Widget.SonosSequencer.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemIconTint">@color/primary</item>
        <item name="itemTextColor">@color/primary</item>
    </style>
    
    <style name="Widget.SonosSequencer.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="Widget.SonosSequencer.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="Widget.SonosSequencer.Card" parent="Widget.Material3.CardView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>
    
    <style name="Widget.SonosSequencer.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="hintTextColor">@color/input_hint</item>
    </style>
    
    <style name="Widget.SonosSequencer.TextView.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="Widget.SonosSequencer.TextView.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="Widget.SonosSequencer.TextView.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="Widget.SonosSequencer.TextView.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
