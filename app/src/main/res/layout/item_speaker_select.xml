<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_xs"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_default">

        <ImageView
            android:id="@+id/speakerIcon"
            android:layout_width="@dimen/image_size_md"
            android:layout_height="@dimen/image_size_md"
            android:src="@drawable/ic_speaker" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_default">

            <TextView
                android:id="@+id/speakerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sonos Speaker"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speakerModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xxs"
                android:text="Model: Play:5"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_sm" />

            <TextView
                android:id="@+id/speakerIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xxs"
                android:text="IP: 192.168.1.100"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_xs" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
